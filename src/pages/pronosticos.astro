---
import Layout from '@/layouts/Layout.astro'
import { pronosticos } from '@/consts/pageTitles'
import BackgroundLayout from '@/layouts/BackgroundLayout.astro'
import { COMBATS } from '@/consts/combats'
import { FIGHTERS } from '@/consts/fighters'
import { obtenerTodosPronosticos } from '@/services/porra'
import Footer from '@/components/Footer.astro'

// Obtener los combates con los datos completos de los luchadores
const combates = COMBATS.map(combate => {
  const luchador1 = FIGHTERS.find(f => f.id === combate.fighters[0])
  const luchador2 = FIGHTERS.find(f => f.id === combate.fighters[1])
  
  return {
    ...combate,
    luchador1,
    luchador2,
  }
}).filter(combate => combate.luchador1 && combate.luchador2)

// Verificar si hay pronósticos
const hayPronosticos = obtenerTodosPronosticos().length > 0
---

<Layout title={pronosticos}>
  <BackgroundLayout>
    <div class="container mx-auto px-4 py-12">
      <h1 class="text-4xl md:text-5xl text-theme-turquoise font-bold text-center mb-8">
        Pronósticos de la comunidad
      </h1>
      
      {hayPronosticos ? (
        <div class="grid gap-8 md:grid-cols-2">
          {combates.map((combate) => (
            <div class="bg-black/70 rounded-lg p-6 shadow-lg">
              <h2 class="text-2xl text-theme-turquoise font-bold text-center mb-6">
                {combate.title}
              </h2>
              
              <div class="flex items-center justify-between mb-6">
                <div class="flex flex-col items-center">
                  <div class="w-24 h-24 rounded-full overflow-hidden mb-2 bg-gray-800 border-2 border-theme-turquoise">
                    <img 
                      src={`/images/fighters/cards/${combate.luchador1.id}.webp`}
                      alt={combate.luchador1.name}
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <span class="text-theme-seashell font-bold">{combate.luchador1.name}</span>
                </div>
                
                <span class="text-theme-turquoise font-bold text-xl">VS</span>
                
                <div class="flex flex-col items-center">
                  <div class="w-24 h-24 rounded-full overflow-hidden mb-2 bg-gray-800 border-2 border-theme-tickle-me-pink">
                    <img 
                      src={`/images/fighters/cards/${combate.luchador2.id}.webp`}
                      alt={combate.luchador2.name}
                      class="w-full h-full object-cover"
                    />
                  </div>
                  <span class="text-theme-seashell font-bold">{combate.luchador2.name}</span>
                </div>
              </div>
              
              <!-- Estadísticas del combate -->
              <div id={`estadisticas-${combate.id}`} class="bg-gray-900/70 rounded-lg p-5 border border-theme-turquoise/30">
                <h3 class="text-xl text-theme-turquoise font-bold text-center mb-4">Estadísticas de la comunidad</h3>
                
                <div class="estadisticas-contenido">
                  <!-- El contenido se cargará con JavaScript -->
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="bg-black/70 rounded-lg p-8 shadow-lg text-center">
          <h2 class="text-3xl text-theme-turquoise font-bold mb-4">Próximamente...</h2>
          <p class="text-theme-seashell mb-6">
            Las estadísticas de los pronósticos estarán disponibles cuando la comunidad comience a votar.
          </p>
          <a 
            href="/la-porra" 
            class="bg-theme-turquoise text-black font-bold py-3 px-10 rounded-lg hover:bg-theme-turquoise/80 inline-block"
          >
            Participar en la porra
          </a>
        </div>
      )}
    </div>
    <Footer />
  </BackgroundLayout>
</Layout>

<script>
  import { obtenerEstadisticasCombate } from '@/services/porra';
  
  function actualizarEstadisticas() {
    const estadisticasElements = document.querySelectorAll('[id^="estadisticas-"]');
    
    estadisticasElements.forEach(el => {
      const combateId = el.id.replace('estadisticas-', '');
      const contenedor = el.querySelector('.estadisticas-contenido');
      
      if (!contenedor) return;
      
      const estadisticas = obtenerEstadisticasCombate(combateId);
      
      // Formatear porcentajes
      const formatPorcentaje = (valor) => `${Math.round(valor)}%`;
      
      // Determinar si hay pronósticos
      const hayPronosticos = estadisticas.total > 0;
      
      if (!hayPronosticos) {
        contenedor.innerHTML = `
          <p class="text-center text-theme-seashell">Aún no hay pronósticos para este combate.</p>
        `;
        return;
      }
      
      // Obtener referencias a los luchadores
      const combateElement = el.closest('div.bg-black\\/70');
      const luchador1Name = combateElement.querySelectorAll('.text-theme-seashell.font-bold')[0].textContent;
      const luchador2Name = combateElement.querySelectorAll('.text-theme-seashell.font-bold')[1].textContent;
      
      const luchador1Id = Object.keys(estadisticas.ganadores)[0];
      const luchador2Id = Object.keys(estadisticas.ganadores)[1];
      
      // Actualizar contenido con los datos actuales
      contenedor.innerHTML = `
        <div>
          <p class="text-center text-theme-seashell mb-4">
            <span class="font-bold">${estadisticas.total}</span> ${estadisticas.total === 1 ? 'persona ha votado' : 'personas han votado'}
          </p>
          
          <!-- Porcentajes de victoria -->
          <div class="mb-6">
            <h4 class="text-theme-seashell font-bold mb-2">¿Quién ganará?</h4>
            
            <div class="flex justify-between text-sm text-theme-seashell mb-1">
              <span>${luchador1Name}</span>
              <span>${luchador2Name}</span>
            </div>
            
            <div class="relative h-8 bg-gray-800 rounded-full overflow-hidden">
              <!-- Barra del luchador 1 -->
              <div 
                class="absolute left-0 top-0 h-full bg-theme-turquoise"
                style="width: ${estadisticas.ganadores[luchador1Id] || 0}%"
              ></div>
              
              <!-- Barra del luchador 2 -->
              <div 
                class="absolute right-0 top-0 h-full bg-theme-tickle-me-pink"
                style="width: ${estadisticas.ganadores[luchador2Id] || 0}%"
              ></div>
              
              <!-- Porcentajes -->
              <div class="absolute inset-0 flex justify-center items-center">
                <span class="text-white font-bold text-sm">
                  ${formatPorcentaje(estadisticas.ganadores[luchador1Id] || 0)} vs ${formatPorcentaje(estadisticas.ganadores[luchador2Id] || 0)}
                </span>
              </div>
            </div>
          </div>
          
          <!-- Métodos de victoria y rondas -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Métodos de victoria -->
            <div>
              <h4 class="text-theme-seashell font-bold mb-2">Método de victoria</h4>
              
              <div class="space-y-2">
                <div class="flex justify-between items-center">
                  <span class="text-theme-seashell">KO / TKO</span>
                  <div class="flex items-center">
                    <div class="w-32 h-4 bg-gray-800 rounded-full mr-2 overflow-hidden">
                      <div class="h-full bg-theme-turquoise" style="width: ${estadisticas.metodos['ko'] || 0}%"></div>
                    </div>
                    <span class="text-theme-seashell">${formatPorcentaje(estadisticas.metodos['ko'] || 0)}</span>
                  </div>
                </div>
                
                <div class="flex justify-between items-center">
                  <span class="text-theme-seashell">Decisión</span>
                  <div class="flex items-center">
                    <div class="w-32 h-4 bg-gray-800 rounded-full mr-2 overflow-hidden">
                      <div class="h-full bg-theme-turquoise" style="width: ${estadisticas.metodos['decision'] || 0}%"></div>
                    </div>
                    <span class="text-theme-seashell">${formatPorcentaje(estadisticas.metodos['decision'] || 0)}</span>
                  </div>
                </div>
                
                <div class="flex justify-between items-center">
                  <span class="text-theme-seashell">Descalificación</span>
                  <div class="flex items-center">
                    <div class="w-32 h-4 bg-gray-800 rounded-full mr-2 overflow-hidden">
                      <div class="h-full bg-theme-turquoise" style="width: ${estadisticas.metodos['descalificacion'] || 0}%"></div>
                    </div>
                    <span class="text-theme-seashell">${formatPorcentaje(estadisticas.metodos['descalificacion'] || 0)}</span>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Rondas -->
            <div>
              <h4 class="text-theme-seashell font-bold mb-2">Ronda de finalización</h4>
              
              <div class="space-y-2">
                <div class="flex justify-between items-center">
                  <span class="text-theme-seashell">Ronda 1</span>
                  <div class="flex items-center">
                    <div class="w-32 h-4 bg-gray-800 rounded-full mr-2 overflow-hidden">
                      <div class="h-full bg-theme-turquoise" style="width: ${estadisticas.rondas['1'] || 0}%"></div>
                    </div>
                    <span class="text-theme-seashell">${formatPorcentaje(estadisticas.rondas['1'] || 0)}</span>
                  </div>
                </div>
                
                <div class="flex justify-between items-center">
                  <span class="text-theme-seashell">Ronda 2</span>
                  <div class="flex items-center">
                    <div class="w-32 h-4 bg-gray-800 rounded-full mr-2 overflow-hidden">
                      <div class="h-full bg-theme-turquoise" style="width: ${estadisticas.rondas['2'] || 0}%"></div>
                    </div>
                    <span class="text-theme-seashell">${formatPorcentaje(estadisticas.rondas['2'] || 0)}</span>
                  </div>
                </div>
                
                <div class="flex justify-between items-center">
                  <span class="text-theme-seashell">Ronda 3</span>
                  <div class="flex items-center">
                    <div class="w-32 h-4 bg-gray-800 rounded-full mr-2 overflow-hidden">
                      <div class="h-full bg-theme-turquoise" style="width: ${estadisticas.rondas['3'] || 0}%"></div>
                    </div>
                    <span class="text-theme-seashell">${formatPorcentaje(estadisticas.rondas['3'] || 0)}</span>
                  </div>
                </div>
                
                <div class="flex justify-between items-center">
                  <span class="text-theme-seashell">Todas las rondas</span>
                  <div class="flex items-center">
                    <div class="w-32 h-4 bg-gray-800 rounded-full mr-2 overflow-hidden">
                      <div class="h-full bg-theme-turquoise" style="width: ${estadisticas.rondas['decision'] || 0}%"></div>
                    </div>
                    <span class="text-theme-seashell">${formatPorcentaje(estadisticas.rondas['decision'] || 0)}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;
    });
  }
  
  // Actualizar estadísticas cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', actualizarEstadisticas);
  
  // Actualizar cuando se vuelve a la página
  document.addEventListener('astro:page-load', actualizarEstadisticas);
  document.addEventListener('astro:after-swap', actualizarEstadisticas);
</script>